# Configuración del cuerpo de Jarbis.
# Copiá a .env y descomentá lo que quieras cambiar.
#
# Generado desde config.py, así que no se puede desalinear (bug 8 del plan:
# el .env.example de GesturePilot documentaba GESTURE_HOLD_TIME_MS=500 cuando
# el default del código era 3000, y le faltaba SILENCE_TIMEOUT entero).

# Raíz del proyecto (contiene models/, var/, web/)
# JARBIS_PROJECT_DIR=/ruta/al/repo/jarbis

# Directorio de modelos (piper/, wakeword/). Derivado de project_dir
# JARBIS_MODELS_DIR=

# Estado runtime: state json, logs, jsonl. Derivado de project_dir
# JARBIS_VAR_DIR=

# Modelo Whisper: tiny, base, small, medium, large
# JARBIS_WHISPER_MODEL=small

# Idioma fijo de transcripción. Fijarlo evita autodetección errática
# JARBIS_WHISPER_LANGUAGE=es

# cpu o cuda. En este hardware siempre cpu (no hay GPU NVIDIA)
# JARBIS_WHISPER_DEVICE=cpu

# int8 en CPU; float16 solo tiene sentido con CUDA
# JARBIS_WHISPER_COMPUTE_TYPE=int8

# Beam search. 5 para el turno real, 1 para el wake word fallback
# JARBIS_WHISPER_BEAM_SIZE=5

# Cargar el modelo al arrancar en vez de en el primer turno. Mata el probl
# ema 3 de PLAN_MEJORAS (latencia de carga por turno)
# JARBIS_WHISPER_PRELOAD=True

# Sesgo de vocabulario para Whisper (nombres propios y jerga)
# JARBIS_WHISPER_INITIAL_PROMPT=Contexto técnico: MyJarbis, Jarbis, SQLite, MCP, Claude Code, WSL, Windows, Python, TypeScript, commit, push, merge, branch, deploy, endpoint.

# onnx (livekit hey_jarvis) | whisper (fallback heredado)
# JARBIS_WAKEWORD_BACKEND=onnx

# Modelo ONNX del wake word. Derivado de models_dir
# JARBIS_WAKEWORD_MODEL_PATH=

# Umbral de activación. Subir si hay falsos positivos
# JARBIS_WAKEWORD_THRESHOLD=0.5

# Escuchar el nombre de forma continua
# JARBIS_WAKEWORD_ENABLED=True

# silero (ONNX, robusto a ruido) | rms (casero heredado)
# JARBIS_VAD_BACKEND=silero

# Modelo ONNX de Silero VAD. Derivado de models_dir
# JARBIS_VAD_MODEL_PATH=

# Segundos de silencio para cerrar el turno. El heredado era 2.0, que se s
# entía lento; 0.7 es el presupuesto de latencia del plan
# JARBIS_SILENCE_TIMEOUT=0.7

# Umbral RMS del VAD casero. Solo aplica con vad_backend=rms
# JARBIS_SILENCE_THRESHOLD=0.02

# Hablar las respuestas
# JARBIS_TTS_ENABLED=True

# Voz Piper. es_AR-daniela-high es la única argentina del catálogo
# JARBIS_TTS_VOICE=es_AR-daniela-high

# Voz de respaldo (CC0, ya presente en el repo)
# JARBIS_TTS_VOICE_FALLBACK=es_ES-davefx-medium

# 16 kHz es lo que esperan Whisper, Silero y el wake word
# JARBIS_AUDIO_SAMPLE_RATE=16000

# Mono para STT
# JARBIS_AUDIO_CHANNELS=1

# Índice de sounddevice. None = default del sistema
# JARBIS_AUDIO_INPUT_DEVICE=

# SIEMPRE loopback. Exponer esto en 0.0.0.0 es el error del CVE-2026-25253
# JARBIS_BRIDGE_HOST=127.0.0.1

# Puerto del WebSocket
# JARBIS_BRIDGE_PORT=8765

# Token compartido. Loopback solo no alcanza como autenticación
# JARBIS_BRIDGE_TOKEN_FILE=

# Detectar presencia por cámara. Apagado por default (decisión 17)
# JARBIS_PRESENCE_ENABLED=False

# Índice de cámara
# JARBIS_CAMERA_INDEX=0

# JARBIS_CAMERA_WIDTH=640

# JARBIS_CAMERA_HEIGHT=480

# JARBIS_CAMERA_FPS=30

# JARBIS_CAMERA_MIRROR=True

# JARBIS_MIN_DETECTION_CONFIDENCE=0.7

# JARBIS_MIN_TRACKING_CONFIDENCE=0.5

# Segundos sin verte para considerarte ausente
# JARBIS_ABSENCE_TIMEOUT=3.0

# Activar por teclado
# JARBIS_HOTKEY_ENABLED=True

# Combo de activación
# JARBIS_HOTKEY_COMBO=ctrl+shift+g

# Timeout del estado LISTENING
# JARBIS_LISTENING_TIMEOUT_S=30

# Segundos de modo conversación antes de volver a pedir el wake word
# JARBIS_CONVERSATION_TIMEOUT_S=30.0

# DEBUG, INFO, WARNING, ERROR
# JARBIS_LOG_LEVEL=INFO

# Estado en vivo que lee la cara (visor web / widget)
# JARBIS_STATE_FILE=

# Historial de turnos en JSONL
# JARBIS_SESSION_LOG=

# Sonidos de feedback
# JARBIS_FEEDBACK_SOUND=True
